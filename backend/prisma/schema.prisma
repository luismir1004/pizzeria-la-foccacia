// Esquema de base de datos · Pizzería La Foccacia
// Modela el catálogo: categorías, productos, precios por tamaño y extras.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id
  name        String
  description String?
  order       Int       @default(0)
  products    Product[]

  @@map("categories")
}

model Product {
  id          String   @id
  name        String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String   @map("category_id")
  image       String
  alt         String?
  ingredients String[] @default([])
  preparation String?
  featured    Boolean  @default(false)
  prices      Price[]
  extras      Extra[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("products")
}

model Price {
  id        Int     @id @default(autoincrement())
  size      String
  price     Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")

  @@index([productId])
  @@map("prices")
}

model Extra {
  id        Int     @id @default(autoincrement())
  name      String
  price     Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")

  @@index([productId])
  @@map("extras")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  mensaje   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}
