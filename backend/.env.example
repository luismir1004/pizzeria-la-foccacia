# Copia este archivo a .env y ajusta los valores.

# Conexión a PostgreSQL (usada por Prisma)
DATABASE_URL="postgresql://admin:CHANGE_ME@localhost:5432/pizzeria?schema=public"

# Puerto del servidor API
PORT=3000

# Orígenes permitidos por CORS (coma-separados). Vacío = reflejar (solo dev).
ALLOWED_ORIGINS=https://pizzeria-la-foccacia.vercel.app

# Credenciales de los contenedores (docker-compose las lee de aquí)
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pizzeria

# pgAdmin (opcional)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
